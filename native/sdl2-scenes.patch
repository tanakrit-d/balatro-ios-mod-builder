+/* Scene lifecycle backport added by balatro-ios-mod-builder. */
+@interface SDLUIKitSceneDelegate : NSObject <UIWindowSceneDelegate>
+@end
+
+@implementation SDLUIKitSceneDelegate
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) return;
+    SDLUIKitDelegate *delegate = [SDLUIKitDelegate sharedAppDelegate];
+    [delegate connectWindowScene:(UIWindowScene *)scene];
+    for (UIOpenURLContext *context in options.URLContexts) {
+        [delegate application:UIApplication.sharedApplication openURL:context.URL options:@{}];
+    }
+}
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)contexts
+{
+    for (UIOpenURLContext *context in contexts) {
+        [[SDLUIKitDelegate sharedAppDelegate] application:UIApplication.sharedApplication openURL:context.URL options:@{}];
+    }
+}
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    SDLUIKitDelegate *delegate = [SDLUIKitDelegate sharedAppDelegate];
+    if (delegate.windowScene == scene) delegate.windowScene = nil;
+}
+@end
+
